{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itad-telegram-mock-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "APP_MODE": "mock",
    "MOCK_CHAT_ID": "mock:local",
    "MOCK_RECEIVER_KEY": "local-mock-only",
    "MOCK_FAILURE": "none",
    "MOCK_FAIL_AT": "1"
  }
}
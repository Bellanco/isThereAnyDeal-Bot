{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itad-telegram-production-replace-me",
  "account_id": "00000000000000000000000000000000",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false }
  },
  "triggers": { "crons": [] },
  "vars": {
    "APP_MODE": "production",
    "LIVE_DELIVERY": "disabled",
    "OAUTH_CLIENT_ID": "REPLACE_WITH_PUBLIC_ITAD_CLIENT_ID",
    "OAUTH_REDIRECT_URI": "http://127.0.0.1:8765/REPLACE_WITH_REGISTERED_CALLBACK",
    "OAUTH_TOKEN_KEY_VERSION": "REPLACE_WITH_KEY_VERSION"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itad-production-replace-me",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}

{
  // LOCAL INTEGRATION ONLY: cron + local D1 + in-memory ITAD/OAuth/Telegram simulation.
  // No secrets, no real network. Never deploy this file (see README).
  // Tick every minute: delivery each tick; ITAD/OAuth only when the durable D1
  // poll gate (5 minutes, migration 0004) is due.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itad-bridge-local-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_MODE": "local-integration"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itad-local-integration",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "migrations"
    }
  ]
}
